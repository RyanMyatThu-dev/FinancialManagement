{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "CreateOrUpdateProductionStackWithApprovedRole",
      "Effect": "Allow",
      "Action": [
        "cloudformation:CreateStack",
        "cloudformation:UpdateStack"
      ],
      "Resource": "arn:aws:cloudformation:ap-southeast-1:079379901631:stack/st-finance-prod-stack/*",
      "Condition": {
        "StringEquals": {
          "cloudformation:RoleArn": "arn:aws:iam::079379901631:role/st-finance/cloudformation/production/st-finance-production-cloudformation-service-role"
        }
      }
    },
    {
      "Sid": "ManageProductionStackChanges",
      "Effect": "Allow",
      "Action": [
        "cloudformation:CreateChangeSet",
        "cloudformation:DeleteChangeSet",
        "cloudformation:DescribeChangeSet",
        "cloudformation:DescribeStackEvents",
        "cloudformation:DescribeStackResource",
        "cloudformation:DescribeStackResources",
        "cloudformation:DescribeStacks",
        "cloudformation:ExecuteChangeSet",
        "cloudformation:GetTemplate",
        "cloudformation:GetTemplateSummary",
        "cloudformation:ListChangeSets",
        "cloudformation:ListStackResources"
      ],
      "Resource": "arn:aws:cloudformation:ap-southeast-1:079379901631:stack/st-finance-prod-stack/*"
    },
    {
      "Sid": "ValidateTemplatesAndDiscoverStacks",
      "Effect": "Allow",
      "Action": [
        "cloudformation:ListStacks",
        "cloudformation:ValidateTemplate"
      ],
      "Resource": "*"
    },
    {
      "Sid": "ReadAndPassProductionCloudFormationRole",
      "Effect": "Allow",
      "Action": [
        "iam:GetRole",
        "iam:PassRole"
      ],
      "Resource": "arn:aws:iam::079379901631:role/st-finance/cloudformation/production/st-finance-production-cloudformation-service-role",
      "Condition": {
        "StringEqualsIfExists": {
          "iam:PassedToService": "cloudformation.amazonaws.com"
        }
      }
    }
  ]
}
