{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ManageServerlessDeploymentServices",
      "Effect": "Allow",
      "Action": [
        "apigateway:*",
        "cloudformation:*",
        "lambda:*",
        "s3:*"
      ],
      "Resource": "*"
    },
    {
      "Sid": "ReadLambdaExecutionRole",
      "Effect": "Allow",
      "Action": "iam:GetRole",
      "Resource": "arn:aws:iam::079379901631:role/st-finance-lambda-execution-role"
    },
    {
      "Sid": "PassLambdaExecutionRole",
      "Effect": "Allow",
      "Action": "iam:PassRole",
      "Resource": "arn:aws:iam::079379901631:role/st-finance-lambda-execution-role",
      "Condition": {
        "StringEquals": {
          "iam:PassedToService": "lambda.amazonaws.com"
        }
      }
    }
  ]
}
