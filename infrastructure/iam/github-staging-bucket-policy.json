{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ReadStagingDeploymentBucket",
      "Effect": "Allow",
      "Action": [
        "s3:GetBucketLocation",
        "s3:ListBucket",
        "s3:ListBucketMultipartUploads"
      ],
      "Resource": "arn:aws:s3:::st-finance-staging-deployments-079379901631-ap-southeast-1"
    },
    {
      "Sid": "ManageStagingDeploymentArtifacts",
      "Effect": "Allow",
      "Action": [
        "s3:AbortMultipartUpload",
        "s3:DeleteObject",
        "s3:GetObject",
        "s3:ListMultipartUploadParts",
        "s3:PutObject"
      ],
      "Resource": "arn:aws:s3:::st-finance-staging-deployments-079379901631-ap-southeast-1/*"
    }
  ]
}
